# Konfiguracja aplikacji Czytnik SF
# Skopiuj ten plik jako .env i uzupełnij wartości

# WAŻNE: Wygeneruj własny klucz!
# Linux/Mac: openssl rand -hex 32
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SECRET_KEY=your-secret-key-here-change-it

# Tryb debug (false na produkcji)
DEBUG=false

# Baza danych (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Limit rozmiaru pliku
MAX_UPLOAD_SIZE_MB=10

# Czas przechowywania plików dla admina (w dniach, 0 = nie przechowuj)
ADMIN_FILE_RETENTION_DAYS=30

# Google reCAPTCHA v2
# Uzyskaj klucze na: https://www.google.com/recaptcha/admin
# Wybierz typ: reCAPTCHA v2 "I'm not a robot" Checkbox
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=true

# Google Analytics
# Uzyskaj ID na: https://analytics.google.com
GA_MEASUREMENT_ID=G-BD3959F2HL

# Dane kontaktowe (wyświetlane na stronie)
CONTACT_EMAIL=kontakt@analizy.io
CONTACT_ADDRESS=
